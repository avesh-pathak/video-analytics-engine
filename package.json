{
  "name": "video-analytics-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Backend-heavy telemetry ingest engine for video watch-time. Server-authoritative recomputation, two-layer idempotency, event log + materialized projection, and a projection repair engine.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "cd web && next dev --webpack ",
    "build": "cd web && next build --webpack",
    "start": "cd web && next start ",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "node -e \"require('fs').rmSync('.data',{recursive:true,force:true});console.log('reset .data')\""
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/postcss": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.69.0",
    "mermaid": "^12.3.0",
    "motion": "^14.9.1",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "optionalDependencies": {
    "kafkajs": "^2.2.4"
  },
  "overrides": {
    "postcss": "^8.5.31"
  }
}
