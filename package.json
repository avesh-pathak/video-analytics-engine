{
  "name": "video-analytics-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Backend-heavy telemetry ingest engine for video watch-time. Server-authoritative recomputation, two-layer idempotency, event log + materialized projection, and a projection repair engine.",
  "type": "module",
  "engines": { "node": ">=22.5.0" },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "node -e \"require('fs').rmSync('.data',{recursive:true,force:true});console.log('reset .data')\""
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  },
  "optionalDependencies": {
    "kafkajs": "^2.2.4"
  },
  "overrides": {
    "postcss": "^8.5.31"
  }
}
